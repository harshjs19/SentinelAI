# Application
APP_ENV=development
APP_NAME=SentinelAI

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=sentinelai

# Inference
TIMESERIES_MODEL_PATH=models/timeseries_fault_classifier.joblib
AUDIO_MODEL_PATH=models/audio_bearing_anomaly_detector.joblib
AUDIO_ENCODER_PATH=models/pretrained/ast-audioset
AUDIO_ENCODER_DEVICE=cpu
VISION_MODEL_PATH=models/vision_pcb1_anomaly_detector.joblib
VISION_ENCODER_PATH=models/pretrained/resnet18
VISION_DEVICE=cpu
THERMAL_MODEL_PATH=models/thermal_condition_classifier.joblib
THERMAL_ENCODER_PATH=models/pretrained/resnet18
THERMAL_DEVICE=cpu

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Optional, used only for explicit Copilot provider smoke/evaluation
OPENAI_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Frontend (Vite development proxy by default; never place secrets here)
VITE_API_BASE_URL=/api
