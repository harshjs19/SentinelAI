# Copy to .env.deploy, replace the password, and keep that file local.
SENTINELAI_POSTGRES_PASSWORD=
SENTINELAI_POSTGRES_DB=sentinelai
SENTINELAI_POSTGRES_USER=sentinelai
SENTINELAI_FRONTEND_PORT=8080
SENTINELAI_LOG_LEVEL=INFO

# Ignored runtime artifacts; paths are relative to compose.deploy.yml by default.
SENTINELAI_MODELS_DIR=./models
SENTINELAI_CHROMA_DIR=./knowledge/chroma
SENTINELAI_EMBEDDINGS_DIR=./knowledge/embeddings

