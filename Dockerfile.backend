FROM ghcr.io/astral-sh/uv:0.12.5 AS uv

FROM python:3.12-slim-bookworm AS runtime

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UVICORN_PORT=8000

RUN apt-get update \
    && apt-get install --no-install-recommends --yes libgomp1 libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 sentinelai \
    && useradd --system --uid 10001 --gid sentinelai --home-dir /app --shell /usr/sbin/nologin sentinelai

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    uv sync --frozen --no-dev --no-install-project

COPY --chown=sentinelai:sentinelai . .

RUN mkdir -p /app/models /app/knowledge/chroma /app/knowledge/embeddings \
    && chown -R sentinelai:sentinelai /app/models /app/knowledge

USER sentinelai

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"]

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--no-access-log"]
